{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://em3k.org/schemas/course-1.schema.json",
  "title": "em3k Course Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "version",
    "title",
    "publisherId",
    "language",
    "license",
    "lessons"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "title": { "type": "string", "minLength": 1 },
    "shortDescription": { "type": "string", "maxLength": 160 },
    "description": { "type": "string" },
    "publisherId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "license": { "type": "string", "minLength": 1 },
    "targetAudience": {
      "enum": [
        "preschool",
        "elementary",
        "middle-school",
        "high-school",
        "college",
        "general"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/categoryClassification" }
    },
    "thumbnail": { "$ref": "#/definitions/packagePath" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/lessonReference" }
    }
  },
  "definitions": {
    "categoryClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "subcategory": { "type": "string", "minLength": 1 }
      }
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\?#]+$"
    },
    "lessonReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "file"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "file": { "$ref": "#/definitions/packagePath" }
      }
    }
  }
}
